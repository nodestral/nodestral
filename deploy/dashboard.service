[Unit]
Description=Nodestral Dashboard Frontend
After=network.target

[Service]
Type=simple
User=nodestral
WorkingDirectory=/opt/nodestral/dashboard
ExecStart=/usr/bin/node .next/standalone/server.js
Environment=PORT=3000 HOSTNAME=0.0.0.0
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
